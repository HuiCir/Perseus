# Choose openai (Responses) or anthropic (Messages).
PERSEUS_API_PROTOCOL=anthropic
PERSEUS_ACTOR_PROVIDER=anthropic-compatible
PERSEUS_ACTOR_MODEL=your-actor-model
PERSEUS_ACTOR_BASE_URL=https://your-provider.example
PERSEUS_ACTOR_API_KEY=
PERSEUS_ACTOR_THINKING=high
PERSEUS_ACTOR_NATIVE_CACHE=auto
PERSEUS_ACTOR_ADAPTIVE_THINKING=auto

# Provider, URL, API type and key inherit the Actor values when omitted.
PERSEUS_SPECULATOR_MODEL=your-speculator-model
PERSEUS_SPECULATOR_THINKING=high
PERSEUS_SPECULATOR_NATIVE_CACHE=auto
PERSEUS_ENABLED=1
PERSEUS_EXACT_ENABLED=0
PERSEUS_SEMANTIC_ENABLED=auto
# All registered tools are available to scoped acquisition workers by default.
# Native tool permissions remain the caller's responsibility.
PERSEUS_SE_TOOLS=*

# Internal action domains and acquisition lifecycle; no Actor takeover.
PERSEUS_TOOL_DERIVATION=on
PERSEUS_DUAL_FRONTIER=on
PERSEUS_SWARM_ENABLED=on
PERSEUS_SE_REFRESH=continuous
PERSEUS_SE_STEP_WIDTH=4
PERSEUS_SE_CONTEXT_GROWTH_RATIO=1
PERSEUS_CROSS_REQUEST_FUTURES=on
